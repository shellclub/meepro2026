# Environment file for `docker compose` on the deploy server (VPS).
# Copy to `.env` in the same directory as docker-compose.yml — NEVER commit the real .env.
# On the VPS this file is now written automatically by the GitHub Actions deploy
# workflow from repo secrets (see .github/workflows/deploy.yml), so you normally
# don't need to create it by hand — this file is just documentation of the shape.
#
# NOTE: DB_PASSWORD is inserted directly into a MySQL connection URL, so avoid
# characters that need URL-encoding (@ : / ? # [ ]). Stick to letters/numbers.

DB_USER=root
DB_PASSWORD=changeme
DB_NAME=meepro_petshop
